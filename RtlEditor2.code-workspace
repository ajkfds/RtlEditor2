{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {},
	// F5 (Run and Debug) starts BOTH sides at once:
	//   - "Run Extension" launches the Extension Development Host (TS/JS side)
	//   - "Launch: SystemVerilog Language Server (C#)" launches the server
	//     under the C# debugger (breakpoints in the server work)
	// They talk over TCP on 127.0.0.1:9250 instead of stdio: the extension
	// reads SVLSP_SERVER_PORT and connects to the already-running server
	// instead of spawning it (see vscode-extension/extension.js).
	//
	// The same configurations also live in vscode-extension/.vscode/launch.json
	// so opening that folder directly still works.
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Run Extension",
				"type": "extensionHost",
				"request": "launch",
				"args": [
					"--extensionDevelopmentPath=${workspaceFolder}/vscode-extension"
				],
				"env": {
					"SVLSP_SERVER_PORT": "9250"
				},
				"outFiles": [
					"${workspaceFolder}/vscode-extension/*.js"
				],
				"sourceMaps": false,
				"resolveSourceMapLocations": [
					"${workspaceFolder}/vscode-extension/*.js"
				],
				"skipFiles": [
					"${workspaceFolder}/vscode-extension/server/**"
				],
				"internalConsoleOptions": "openOnSessionStart"
			},
			{
				"name": "Launch: SystemVerilog Language Server (C#)",
				"type": "coreclr",
				"request": "launch",
				"preLaunchTask": "build-server",
				"program": "${workspaceFolder}/SystemVerilogLanguageServer/bin/Debug/net10.0/SystemVerilogLanguageServer.dll",
				"args": [
					"--port",
					"9250"
				],
				"cwd": "${workspaceFolder}/SystemVerilogLanguageServer",
				"console": "internalConsole",
				"stopAtEntry": false,
				"env": {
					"DOTNET_ENVIRONMENT": "Development"
				}
			}
		],
		"compounds": [
			{
				"name": "Extension + Language Server",
				"configurations": [
					"Launch: SystemVerilog Language Server (C#)",
					"Run Extension"
				],
				// The server must be listening before the extension host tries
				// to connect. The extension retries for 30s, so this is only a
				// nicety, but it makes the first connection immediate.
				"stopAll": true
			}
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "build-server",
				"type": "shell",
				"command": "dotnet",
				"args": [
					"build",
					"${workspaceFolder}/SystemVerilogLanguageServer/SystemVerilogLanguageServer.csproj",
					"-clp:ErrorsOnly"
				],
				"options": {
					"cwd": "${workspaceFolder}/SystemVerilogLanguageServer"
				},
				"problemMatcher": "$msCompile",
				"group": "build"
			}
		]
	}
}

{
	"folders": [
		{
			// The folder needs an explicit name: in a .code-workspace file the
			// plain ${workspaceFolder} variable cannot be resolved (a workspace
			// may contain several folders), so launch.json / tasks.json entries
			// defined here must use ${workspaceFolder:RtlEditor2} instead.
			"name": "RtlEditor2",
			"path": "."
		}
	],
	"settings": {},
	// F5 (Run and Debug) starts BOTH sides at once:
	//   - "Run Extension" launches the Extension Development Host (TS/JS side)
	//   - "Launch: SystemVerilog Language Server (C#)" launches the server
	//     under the C# debugger (breakpoints in the server work)
	// They talk over TCP on 127.0.0.1:9250 instead of stdio: the extension
	// reads SVLSP_SERVER_PORT and connects to the already-running server
	// instead of spawning it (see vscode-extension/extension.js).
	//
	// The same configurations also live in vscode-extension/.vscode/launch.json
	// so opening that folder directly still works.
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Run Extension",
				"type": "extensionHost",
				"request": "launch",
				"args": [
					"--extensionDevelopmentPath=${workspaceFolder:RtlEditor2}/vscode-extension"
				],
				"env": {
					"SVLSP_SERVER_PORT": "9250"
				},
				"outFiles": [
					"${workspaceFolder:RtlEditor2}/vscode-extension/*.js"
				],
				"sourceMaps": false,
				"resolveSourceMapLocations": [
					"${workspaceFolder:RtlEditor2}/vscode-extension/*.js"
				],
				"skipFiles": [
					"${workspaceFolder:RtlEditor2}/vscode-extension/server/**"
				],
				"internalConsoleOptions": "openOnSessionStart"
			},
			{
				"name": "Launch: SystemVerilog Language Server (C#)",
				"type": "coreclr",
				"request": "launch",
				"preLaunchTask": "build-server",
				"program": "${workspaceFolder:RtlEditor2}/SystemVerilogLanguageServer/bin/Debug/net10.0/SystemVerilogLanguageServer.dll",
				"args": [
					"--port",
					"9250"
				],
				"cwd": "${workspaceFolder:RtlEditor2}/SystemVerilogLanguageServer",
				"console": "internalConsole",
				"stopAtEntry": false,
				"env": {
					"DOTNET_ENVIRONMENT": "Development"
				}
			}
		],
		"compounds": [
			{
				"name": "Extension + Language Server",
				"configurations": [
					"Launch: SystemVerilog Language Server (C#)",
					"Run Extension"
				],
				// The server must be listening before the extension host tries
				// to connect. The extension retries for 10s and then falls back
				// to spawning the server itself, so the order is not critical.
				//
				// stopAll MUST stay false. With true, a failure of the C# server
				// session (a failing preLaunchTask, a port already in use, the
				// debugger detaching, ...) also kills the extension host. That
				// shows up as "the extension failed to start" with the host
				// exiting with code 134 *before any extension code runs* - no
				// exthost log folder is even created, so nothing is diagnosable.
				// Keeping it false lets the extension host survive and fall back
				// to spawning the server over stdio.
				"stopAll": false
			}
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "build-server",
				"type": "shell",
				"command": "dotnet",
				"args": [
					"build",
					"${workspaceFolder:RtlEditor2}/SystemVerilogLanguageServer/SystemVerilogLanguageServer.csproj",
					"-clp:ErrorsOnly"
				],
				"options": {
					"cwd": "${workspaceFolder:RtlEditor2}/SystemVerilogLanguageServer"
				},
				"problemMatcher": "$msCompile",
				"group": "build"
			}
		]
	}
}

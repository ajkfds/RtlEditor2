{
    "version": "0.2.0",
    "configurations": [
        {
            // Debugs the extension host (TypeScript/JavaScript side) on its own.
            // The extension spawns the language server over stdio as usual, so
            // this works without any other configuration running.
            "name": "Run Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}"
            ],
            // This is a plain-JS extension: only the two source files at the
            // extension root are debuggable. Do NOT glob **/*.js here: the
            // bundled server under server/ (a publish output, git-ignored)
            // contains multi-megabyte Playwright bundles and per-platform
            // runtimes. Matching them makes the debug adapter try to resolve
            // source maps for thousands of files, which kills the debug
            // session and closes the Extension Development Host window right
            // after it opens.
            "outFiles": [
                "${workspaceFolder}/*.js"
            ],
            "sourceMaps": false,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/*.js"
            ],
            "skipFiles": [
                "${workspaceFolder}/server/**"
            ],
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            // Debugs the extension host AND connects to a language server that
            // is already listening on 127.0.0.1:9250 instead of spawning it.
            // Use this together with "Launch: SystemVerilog Language Server
            // (C#)" (or the "Extension + Language Server" compound) so
            // breakpoints in the C# server are hit.
            "name": "Run Extension (connect to C# debug server)",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}"
            ],
            "env": {
                "SVLSP_SERVER_PORT": "9250"
            },
            "outFiles": [
                "${workspaceFolder}/*.js"
            ],
            "sourceMaps": false,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/*.js"
            ],
            "skipFiles": [
                "${workspaceFolder}/server/**"
            ],
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            // Debugs the C# language server. It listens on the same loopback
            // port the extension connects to (SVLSP_SERVER_PORT above), so the
            // extension host and the server talk over TCP instead of stdio.
            //
            // Launching (not attaching) is what makes breakpoints in the
            // server work: the debugger owns the process from the start.
            "name": "Launch: SystemVerilog Language Server (C#)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-server",
            "program": "${workspaceFolder}/../SystemVerilogLanguageServer/bin/Debug/net10.0/SystemVerilogLanguageServer.dll",
            "args": [
                "--port",
                "9250"
            ],
            "cwd": "${workspaceFolder}/../SystemVerilogLanguageServer",
            "console": "internalConsole",
            "stopAtEntry": false,
            "env": {
                "DOTNET_ENVIRONMENT": "Development"
            }
        }
    ],
    "compounds": [
        {
            // One F5 starts both sides. The server is listed first so it is
            // already listening when the extension host connects (the
            // extension also retries for 10s and then spawns the server
            // itself, so the order is not critical).
            //
            // stopAll MUST stay false. With true, a failure of the C# server
            // session (a failing preLaunchTask, a port already in use, the
            // debugger detaching, ...) also kills the extension host. That
            // shows up as "the extension failed to start" with the host
            // exiting with code 134 *before any extension code runs* - no
            // exthost log folder is even created, so nothing is diagnosable.
            "name": "Extension + Language Server",
            "configurations": [
                "Launch: SystemVerilog Language Server (C#)",
                "Run Extension (connect to C# debug server)"
            ],
            "stopAll": false
        }
    ]
}

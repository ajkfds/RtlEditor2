{
  "name": "systemverilog-lsp",
  "displayName": "SystemVerilog LSP (RtlEditor2)",
  "description": "SystemVerilog language server (definition, references, hover, document symbols) backed by RtlEditor2 SystemVerilogLanguageServer",
  "version": "0.1.0",
  "publisher": "rtleditor2",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:systemverilog",
    "onLanguage:verilog"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "systemverilog"
        ],
        "extensions": [
          ".sv",
          ".svh"
        ]
      },
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh"
        ]
      }
    ],
    "configurationDefaults": {
      "editor.semanticHighlighting.enabled": true,
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "keyword": "#569CD6",
          "comment": "#6A9955",
          "type": "#4EC9B0",
          "function": "#4EC9B0",
          "parameter": "#FF5EC2",
          "macro": "#FF5EC2",
          "property": "#FF96C8",
          "variable": "#FFC8C8",
          "number": "#CE9178",
          "string": "#CE9178",
          "register": "#FF3232",
          "identifier": "#D4D4D4"
        }
      }
    },
    "configuration": {
      "title": "SystemVerilog LSP",
      "properties": {
        "systemverilogLsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the published SystemVerilogLanguageServer executable (or its directory). If empty, the extension tries 'dotnet run --project' fallback."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package"
  }
}

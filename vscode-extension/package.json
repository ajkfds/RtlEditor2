{
  "name": "systemverilog-lsp",
  "displayName": "SystemVerilog LSP (RtlEditor2)",
  "description": "SystemVerilog language server (definition, references, hover, document symbols) backed by RtlEditor2 SystemVerilogLanguageServer",
  "version": "0.1.0",
  "publisher": "rtleditor2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajkfds/RtlEditor2.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://github.com/ajkfds/RtlEditor2/tree/main/vscode-extension",
  "bugs": {
    "url": "https://github.com/ajkfds/RtlEditor2/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:systemverilog",
    "onLanguage:verilog",
    "onView:systemverilogLsp.hierarchy"
  ],
  "main": "./extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "systemverilogLsp.hierarchy",
          "name": "RTL Hierarchy",
          "icon": "$(type-hierarchy)",
          "contextualTitle": "RTL Hierarchy"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "systemverilogLsp.hierarchy",
        "contents": "No SystemVerilog / Verilog files found in the workspace.\nOpen a folder that contains .sv/.svh/.v/.vh files."
      }
    ],
    "commands": [
      {
        "command": "systemverilogLsp.refreshHierarchy",
        "title": "Refresh Hierarchy",
        "icon": "$(refresh)"
      },
      {
        "command": "systemverilogLsp.openHierarchyNode",
        "title": "Open"
      },
      {
        "command": "systemverilogLsp.copyHierarchyPath",
        "title": "Copy Instance Path"
      },
      {
        "command": "systemverilogLsp.revealInEditor",
        "title": "Reveal in Editor"
      },
      {
        "command": "systemverilogLsp.addFolder",
        "title": "Add Folder"
      },
      {
        "command": "systemverilogLsp.addBlankFile",
        "title": "Add Blank File"
      },
      {
        "command": "systemverilogLsp.deleteNode",
        "title": "Delete"
      },
      {
        "command": "systemverilogLsp.openInExplorer",
        "title": "Open in Explorer"
      },
      {
        "command": "systemverilogLsp.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "systemverilogLsp.showProperty",
        "title": "Property"
      },
      {
        "command": "systemverilogLsp.snippet.alwaysFF",
        "title": "Insert alwaysFF Block",
        "category": "SystemVerilog Snippet"
      },
      {
        "command": "systemverilogLsp.snippet.moduleInstance",
        "title": "Insert Module Instance",
        "category": "SystemVerilog Snippet"
      },
      {
        "command": "systemverilogLsp.snippet.portConnectionCreate",
        "title": "Fill Port Connections",
        "category": "SystemVerilog Snippet"
      },
      {
        "command": "systemverilogLsp.snippet.portInvert",
        "title": "Invert Selected Ports",
        "category": "SystemVerilog Snippet"
      },
      {
        "command": "systemverilogLsp.snippet.modport",
        "title": "Generate Modport",
        "category": "SystemVerilog Snippet"
      },
      {
        "command": "systemverilogLsp.showLog",
        "title": "SystemVerilog LSP: Show Log",
        "icon": "$(output)"
      },
      {
        "command": "systemverilogLsp.showLogFilePath",
        "title": "SystemVerilog LSP: Copy Log File Path"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "systemverilogLsp.snippet.alwaysFF",
          "when": "editorLangId == systemverilog || editorLangId == verilog",
          "group": "systemverilogSnippet@1"
        },
        {
          "command": "systemverilogLsp.snippet.moduleInstance",
          "when": "editorLangId == systemverilog || editorLangId == verilog",
          "group": "systemverilogSnippet@2"
        },
        {
          "command": "systemverilogLsp.snippet.portConnectionCreate",
          "when": "editorLangId == systemverilog || editorLangId == verilog",
          "group": "systemverilogSnippet@3"
        },
        {
          "command": "systemverilogLsp.snippet.portInvert",
          "when": "editorLangId == systemverilog || editorLangId == verilog",
          "group": "systemverilogSnippet@4"
        },
        {
          "command": "systemverilogLsp.snippet.modport",
          "when": "editorLangId == systemverilog || editorLangId == verilog",
          "group": "systemverilogSnippet@5"
        }
      ],
      "view/title": [
        {
          "command": "systemverilogLsp.refreshHierarchy",
          "when": "view == systemverilogLsp.hierarchy",
          "group": "navigation"
        },
        {
          "command": "systemverilogLsp.showLog",
          "when": "view == systemverilogLsp.hierarchy",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "systemverilogLsp.revealInEditor",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlInstance",
          "group": "inline"
        },
        {
          "command": "systemverilogLsp.copyHierarchyPath",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlInstance",
          "group": "3_copy"
        },
        {
          "command": "systemverilogLsp.revealInEditor",
          "when": "view == systemverilogLsp.hierarchy && (viewItem == rtlInstance || viewItem == rtlFile)",
          "group": "0_open"
        },
        {
          "command": "systemverilogLsp.addFolder",
          "when": "view == systemverilogLsp.hierarchy && (viewItem == rtlFolder || viewItem == rtlFile || viewItem == rtlInstance)",
          "group": "1_add"
        },
        {
          "command": "systemverilogLsp.addBlankFile",
          "when": "view == systemverilogLsp.hierarchy && (viewItem == rtlFolder || viewItem == rtlFile || viewItem == rtlInstance)",
          "group": "1_add"
        },
        {
          "command": "systemverilogLsp.deleteNode",
          "when": "view == systemverilogLsp.hierarchy && (viewItem == rtlFile || viewItem == rtlFolder)",
          "group": "2_edit"
        },
        {
          "command": "systemverilogLsp.copyPath",
          "when": "view == systemverilogLsp.hierarchy && (viewItem == rtlFile || viewItem == rtlInstance || viewItem == rtlFolder)",
          "group": "3_copy"
        },
        {
          "command": "systemverilogLsp.openInExplorer",
          "when": "view == systemverilogLsp.hierarchy && (viewItem == rtlFile || viewItem == rtlFolder || viewItem == rtlInstance)",
          "group": "4_explorer"
        },
        {
          "command": "systemverilogLsp.showProperty",
          "when": "view == systemverilogLsp.hierarchy && (viewItem == rtlFile || viewItem == rtlInstance)",
          "group": "5_property"
        }
      ]
    },
    "languages": [
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "systemverilog"
        ],
        "extensions": [
          ".sv",
          ".svh"
        ]
      },
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh"
        ]
      }
    ],
    "configurationDefaults": {
      "editor.semanticHighlighting.enabled": true,
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "keyword": "#569CD6",
          "comment": "#6A9955",
          "type": "#4EC9B0",
          "function": "#4EC9B0",
          "parameter": "#FF5EC2",
          "macro": "#FF5EC2",
          "property": "#FF96C8",
          "variable": "#FFC8C8",
          "number": "#CE9178",
          "string": "#CE9178",
          "register": "#FF3232",
          "identifier": "#D4D4D4"
        }
      }
    },
    "configuration": {
      "title": "SystemVerilog LSP",
      "properties": {
        "systemverilogLsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to a SystemVerilogLanguageServer executable. Leave empty to use the server bundled under the extension's 'server' folder."
        }
      }
    }
  },
  "scripts": {
    "bundle-server": "node scripts/bundle-server.js",
    "package": "npm run bundle-server && vsce package",
    "package:nobundle": "vsce package"
  }
}
